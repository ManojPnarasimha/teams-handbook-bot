# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# --- Required for the RAG pipeline (chat_local.py / app.py) ---
# Free key, no credit card: https://console.groq.com -> API Keys -> Create
GROQ_API_KEY=gsk_your_key_here

# Optional overrides
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Only needed if you're running app.py through Microsoft Teams (see SETUP.md Part 5) ---
# MicrosoftAppId=
# MicrosoftAppPassword=
# MicrosoftAppType=SingleTenant
# MicrosoftAppTenantId=
