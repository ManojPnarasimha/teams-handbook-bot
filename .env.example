# ---- Supabase ----
# Supabase Dashboard → Project Settings → API
# SUPABASE_SERVICE_KEY is the `service_role` key (secret, server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- LLM provider (set at least one) ----
# Groq:   https://console.groq.com/keys        (default chat provider)
# Gemini: https://aistudio.google.com/apikey   (required for embeddings, optional chat)
# LLM_PROVIDER=groq            # optional override: "groq" | "gemini"
GROQ_API_KEY=
# GEMINI_API_KEY is also required for embeddings (see below), even when Groq is the chat LLM.
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings (Gemini gemini-embedding-001, 768-dim — matches db/schema.sql) ----
# Uses GEMINI_API_KEY above. No separate embedding provider key needed.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ---- Bot Framework / Azure Bot Service ----
# Azure Portal → your Azure Bot resource → Configuration (App ID)
# and its App Registration → Certificates & secrets (App Password).
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# ---- SharePoint (Microsoft Graph, MSAL client-credentials) ----
# Dedicated Entra ID App Registration (separate from the bot's own registration).
# Requires application permission `Sites.Selected`, admin-consented, and
# explicitly granted access to SHAREPOINT_SITE_ID via the one-time Graph POST
# in the README §5.
# SITE_ID / DRIVE_ID: fetch via Graph Explorer, see README §2.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Optional subfolder inside the drive, e.g. "HR Documents". Empty = drive root.
SHAREPOINT_FOLDER_PATH=
# Set to "1" to walk subfolders recursively; default is non-recursive.
SHAREPOINT_RECURSIVE=0

# ---- Shared secret for POST /internal/sharepoint-sync (called by pg_cron) ----
# Generate: openssl rand -hex 32
SYNC_SECRET=replace-with-long-random-string

# ---- Behaviour knobs ----
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.72
SHORT_TERM_LIMIT=10
SUMMARY_EVERY_TURNS=20
LOG_LEVEL=INFO
