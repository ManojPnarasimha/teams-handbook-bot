# ---- Azure SQL Database ----
# Full ODBC connection string. Copy from Azure portal → SQL DB → Settings → Connection strings → ODBC.
# Fill in your username/password.
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Uid=<user>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Pool sizing — free-tier serverless allows only a handful of connections; keep small.
AZURE_SQL_POOL_MIN=1
AZURE_SQL_POOL_MAX=4

# ---- Azure OpenAI ----
# From Azure portal → Azure OpenAI resource → Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment NAMES (not model names). Create them in Azure AI Foundry.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=emb-small
AZURE_OPENAI_CHAT_DEPLOYMENT=chat-mini
# Must match db/schema.sql VECTOR(<n>) — 768 keeps storage small.
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=64

# ---- Azure Document Intelligence ----
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout

# ---- LLM fallback (Groq) ----
# Optional. If Azure OpenAI fails or is unavailable, we fall back to Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Bot Framework / Azure Bot Service ----
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# ---- SharePoint (Microsoft Graph via MSAL client-credentials) ----
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Optional subfolder inside the drive, e.g. "HR Documents". Empty = drive root.
SHAREPOINT_FOLDER_PATH=
# Set to "1" to walk subfolders recursively.
SHAREPOINT_RECURSIVE=0

# ---- Scheduled sync toggle ----
# 0 = /internal/sharepoint-sync returns 403 regardless of secret (safe default).
# 1 = endpoint accepts requests with X-Sync-Secret and runs ingestion in background.
# Manual ingestion via `python ingest.py` is always available.
SCHEDULED_SYNC_ENABLED=0
# Generate with: openssl rand -hex 32
SYNC_SECRET=

# ---- Behaviour knobs ----
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
SHORT_TERM_LIMIT=10
SUMMARY_EVERY_TURNS=20
LOG_LEVEL=INFO

# ---- Chunking (ingest.py) ----
CHUNK_TARGET_CHARS=500
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=80
CHUNK_MIN_CHARS=80

# ---- PDF extraction ----
# Min chars PyMuPDF must extract before we trust it over the Azure DI OCR fallback.
PYMUPDF_MIN_CHARS=200
