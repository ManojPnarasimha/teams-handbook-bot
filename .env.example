# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
STORAGE_BUCKET=org-docs

# ---- LLM provider (set at least one) ----
# LLM_PROVIDER=groq            # optional override: "groq" | "gemini"
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings (1536-dim required by db/schema.sql) ----
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Bot Framework / Azure Bot Service ----
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# ---- Supabase Database Webhook shared secret ----
WEBHOOK_SECRET=replace-with-long-random-string

# ---- Behaviour knobs ----
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.72
SHORT_TERM_LIMIT=10
SUMMARY_EVERY_TURNS=20
LOG_LEVEL=INFO
